{
  "name": "icadp-llama-cpp-server",
  "version": "2.0.0",
  "description": "node-llama-cpp inference server for ICADP 3.0 — full features",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node serve.js",
    "inference": "node index.js",
    "dev": "node --watch serve.js",
    "gpu-info": "npx --no node-llama-cpp inspect gpu",
    "pull": "npx --no node-llama-cpp pull --dir ./models",
    "chat": "npx --no node-llama-cpp chat",
    "postinstall": "mkdir -p models"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.75.5",
    "@earendil-works/pi-ai": "^0.75.5",
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "node-llama-cpp": "^3.0.0",
    "sandbox-agent": "^0.4.2",
    "uuid": "^14.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
