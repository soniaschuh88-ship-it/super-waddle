# ICADP 3.0 — Environment Configuration
#
# Copy this file to .icadp.env and edit as needed.
# The file is sourced by icadp.sh on every start/stop/status call.
#
# .icadp.env is gitignored — safe to store local overrides here.

# ── Ports ─────────────────────────────────────────────────────────────────────
ICADP_PORT=4000           # Main app + API server (serve.js)
ICADP_LLAMA_PORT=8001     # node-llama-cpp inference server
ICADP_OLLAMA_PORT=11434   # Ollama

# ── Tunnel ────────────────────────────────────────────────────────────────────
ICADP_TUNNEL=1            # 1 = open a serveo.net tunnel on start, 0 = skip

# ── Build ─────────────────────────────────────────────────────────────────────
ICADP_NO_BUILD=0          # 1 = skip rebuild check (faster restart)

# ── Dev server ────────────────────────────────────────────────────────────────
# ICADP_DEV_PORT=5173     # Vite dev server port (./icadp.sh dev)
