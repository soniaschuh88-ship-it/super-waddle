# bKG — best Known Garbage
# Environment Configuration
#
# Copy to .env (in the project root) and fill in values.
# The .env file is loaded by server/serve.js on startup.
# Never commit .env — it's in .gitignore.

# ── Server ─────────────────────────────────────────────────────────────────────
BKG_PORT=4001                            # App server port
BKG_HOST=0.0.0.0                        # Bind address
BKG_LLAMA_PORT=8001                      # node-llama-cpp inference port
BKG_OLLAMA_PORT=11434                    # Ollama port
BKG_TUNNEL=1                             # 1 = open serveo tunnel on start

# ── Security ───────────────────────────────────────────────────────────────────
# Admin password hash (bcrypt, cost 12).
# Generate: node -e "const b=require('bcryptjs');console.log(b.hashSync('yourpassword',12))"
# Default below = "bkg_admin_2024" — CHANGE THIS in production!
BKG_ADMIN_PASSWORD_HASH=$2a$12$WbQ3GqZkUj5V.fN1YHNrBOOt6hSiZ6YqHknJcuRnKWrWPTqhJLaM2

# Secret for signing JWT session tokens (admin sessions)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BKG_JWT_SECRET=change-me-generate-a-random-64-char-hex-string

# ── Paths ──────────────────────────────────────────────────────────────────────
# Override the user config directory (default: ~/.bkg)
# BKG_DIR=/home/user/.bkg

# Override the SQLite database path (default: BKG_DIR/db.sqlite)
# BKG_DB_PATH=/home/user/.bkg/bkg.sqlite

# ── API Keys (for external providers, optional) ────────────────────────────────
# These are injected into agent sessions so coding agents can use cloud APIs.
# Leave blank if you only use local models.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Tunnel ────────────────────────────────────────────────────────────────────
# Set to 0 to disable the serveo tunnel (for air-gapped / no-internet setups)
# BKG_TUNNEL=0
